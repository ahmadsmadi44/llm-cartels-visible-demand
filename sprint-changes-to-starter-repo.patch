+class MaverickSeller(Agent):
+    """
+    [sprint addition] A rule-based, non-communicating competitive seller (the "maverick").
+
+    Adaptive-margin rule in the spirit of Cliff's ZIP traders (Cliff & Bruten 1997): the seller keeps a
+    target price and moves it with a Widrow-Hoff step toward a reference price read from the last hour.
+      * sold last hour at or below the prevailing trade price -> nudge price UP toward that price (+0-5%)
+        (it is not altruistic: it raises prices when it can);
+      * did NOT sell last hour -> undercut: move DOWN toward min(prevailing trade price, lowest rival ask)
+        minus 0-5%. Never asks below cost + floor.
+    It sends no messages and reads none. Deterministic given its own RNG seed.
+    """
+    price: float = 0.0
+    beta: float = 0.35
+    floor_margin: float = 0.5
+    init_markup: float = 0.12
+    rng_seed: int = 0
+    _rng: Any = None
+
+    class Config:
+        arbitrary_types_allowed = True
+
+    def __init__(self, **data):
+        super().__init__(**data)
+        self._rng = random.Random(self.rng_seed)
+        if self.price <= 0:
+            self.price = round(self.valuation * (1 + self.init_markup), 2)
+
+    def generate_bid_response(self, **kwargs: Any) -> AgentBidResponse:
+        last_round = kwargs.get("last_round")
+        if last_round is not None:
+            trades = [t.price for t in last_round.trades]
+            sold = any(t.seller_id == self.id for t in last_round.trades)
+            rival_asks = [a for sid, a in last_round.seller_asks.items() if sid != self.id and a is not None]
+            bids = [b for b in last_round.buyer_bids.values() if b is not None]
+            ref = (sum(trades) / len(trades)) if trades else (max(bids) if bids else self.price)
+            if sold and self.price <= ref:
+                target = ref * (1 + self._rng.uniform(0.0, 0.05))
+            elif not sold:
+                anchor = min([ref] + rival_asks)
+                target = anchor * (1 - self._rng.uniform(0.0, 0.05))
+            else:
+                target = self.price
+            self.price += self.beta * (target - self.price)
+        self.price = round(max(self.price, self.valuation + self.floor_margin), 2)
+        return {"ask": self.price}
+
+
+class FixedPriceSeller(Agent):
+    """[sprint addition] An aggressive entrant: always asks a fixed price (default cost + $5), never chats."""
+    fixed_ask: float = 85.0
+
+    def generate_bid_response(self, **kwargs: Any) -> AgentBidResponse:
+        return {"ask": round(self.fixed_ask, 2)}
+
+
+class StrategicBuyer(Agent):
+    """[sprint addition] A bid-shading buyer that does not reveal its willingness to pay.
+    Starts below the market, lowers its bid by `down` after a fill (tries cheaper), raises it by `up` after a miss,
+    never above 99% of value. Rule-based, no model calls."""
+    bid: float = 0.0
+    down: float = 1.0
+    up: float = 1.0
+    start_discount: float = 3.0
+
+    def generate_bid_response(self, **kwargs: Any) -> AgentBidResponse:
+        last_round = kwargs.get("last_round")
+        cap = self.valuation * 0.99
+        if self.bid <= 0:
+            trades = [t.price for t in (last_round.trades if last_round else [])]
+            ref = (sum(trades) / len(trades)) if trades else cap
+            self.bid = ref - self.start_discount
+        elif last_round is not None:
+            filled = any(t.buyer_id == self.id for t in last_round.trades)
+            self.bid = self.bid - self.down if filled else self.bid + self.up
+        self.bid = round(min(cap, max(self.bid, 80.5)), 2)
+        return {"bid": self.bid}
